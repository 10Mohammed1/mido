# ══════════════════════════════════════════════════════════════════════════════
#  Mido · environment file example
#
#  Copy to `.env` (already git-ignored) and edit:
#        cp .env.example .env
#
#  Every key is optional: when a key is missing the value written in
#  `config.py` is used, so an empty .env keeps the bot running exactly as
#  before.  Use it to rotate credentials or to deploy somewhere else.
# ══════════════════════════════════════════════════════════════════════════════

# ── Telegram credentials (user account) ──────────────────────────────────────
APP_ID=
API_HASH=
STRING_SESSION=

# ── assistant bot ────────────────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_BOT_USERNAME=

# ── owner ────────────────────────────────────────────────────────────────────
OWNER_ID=
ALIVE_NAME=

# ── storage ──────────────────────────────────────────────────────────────────
DB_URI=sqlite:///./Mido.db

# ── logging / heroku (optional) ──────────────────────────────────────────────
PRIVATE_GROUP_BOT_API_ID=0
PM_LOGGER_GROUP_ID=0
HEROKU_API_KEY=
HEROKU_APP_NAME=

# ── misc ─────────────────────────────────────────────────────────────────────
COMMAND_HAND_LER=.
SUDO_COMMAND_HAND_LER=.
TZ=Africa/Cairo
# plugins to keep un-loaded (comma separated)
NO_LOAD=vcplayer
